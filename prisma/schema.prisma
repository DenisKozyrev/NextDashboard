generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String
  image_url String
  invoices  Invoice[]
}

model Invoice {
  id          String   @id @default(uuid())
  customer_id String
  amount      Int
  status      String
  date        DateTime @db.Date
  customer    Customer @relation(fields: [customer_id], references: [id])
}

model Revenue {
  month   String @id
  revenue Int
}
